{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Bind: 0.0.0.0 listens on all interfaces so the trainer PC can reach the
  // dashboard over the LAN (localhost keeps working too). Development keeps
  // the same 0.0.0.0 bind (see appsettings.Development.json) so every launch
  // path — dev `dotnet run`, bundle, and launcher — is LAN-reachable.
  // Closed demo LAN only.
  "Urls": "http://0.0.0.0:5247",
  "Jwt": {
    "Key": "CockpitSim_Secret_Key_32_Characters_Or_Longer_For_Security!",
    "Issuer": "CockpitSimAPI",
    "Audience": "CockpitSimClient"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=Data/app.db"
  },
  "Telemetry": {
    "MinimumAgeSeconds": 900,
    "SilenceSeconds": 600
  }
}